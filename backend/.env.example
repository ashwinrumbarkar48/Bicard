# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bicard?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=7d

# ---- Email (SMTP) — leave SMTP_HOST blank to log emails to console in dev ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_email_password
MAIL_FROM=no-reply@bicard.org
LEADS_NOTIFY_EMAIL=leads@bicard.org

# ---- Frontend URLs (used for CORS, reset links, sitemap) ----
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Comma-separated list of allowed origins (overrides the localhost defaults)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

# ---- Google reCAPTCHA v3 (leave blank to disable in dev) ----
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# ---- Seed admin (used by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@bicard.org
SEED_ADMIN_PASSWORD=Admin@123
